{
  "name": "tree-view",
  "title": "Tree View",
  "type": "registry:ui",
  "internal": false,
  "dependencies": [
    "@lucide/vue"
  ],
  "registryDependencies": [
    "utils"
  ],
  "files": [
    {
      "name": "tree-view/TreeView.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed, provide, ref, type HTMLAttributes } from \"vue\"\n\nimport { cn } from \"@/lib/utils\"\nimport TreeViewNode from \"./TreeViewNode.vue\"\nimport { TreeViewContextKey, flatten, type TreeItem, type VisibleItem } from \"./context\"\n\nconst props = withDefaults(\n  defineProps<{\n    items: TreeItem[]\n    /** Selected id when v-model is not bound. */\n    defaultValue?: string | null\n    /** Open ids when v-model:expanded is not bound. */\n    defaultExpanded?: string[]\n    class?: HTMLAttributes[\"class\"]\n  }>(),\n  { defaultValue: null, defaultExpanded: () => [] },\n)\n\nconst emit = defineEmits<{\n  /** Fires with the item on every selection, like React's onValueChange(id, item). */\n  select: [id: string, item: TreeItem]\n}>()\n\n/** The selected item id. */\nconst value = defineModel<string | null | undefined>({ default: undefined })\n/** The ids of the open branches. */\nconst expanded = defineModel<string[] | undefined>(\"expanded\", { default: undefined })\n\nconst uncontrolledValue = ref<string | null>(props.defaultValue)\nconst uncontrolledExpanded = ref<string[]>(props.defaultExpanded)\n\nconst selected = computed(() => (value.value !== undefined ? value.value : uncontrolledValue.value))\nconst open = computed(() => new Set(expanded.value ?? uncontrolledExpanded.value))\nconst visible = computed(() => flatten(props.items, open.value))\nconst focusedId = ref<string | null>(null)\nconst refs = new Map<string, HTMLLIElement>()\n\nconst tabStop = computed(\n  () =>\n    visible.value.find((entry) => entry.item.id === focusedId.value)?.item.id ??\n    visible.value.find((entry) => entry.item.id === selected.value)?.item.id ??\n    visible.value[0]?.item.id,\n)\n\nfunction setOpen(id: string, next: boolean) {\n  const list = new Set(open.value)\n  if (next) list.add(id)\n  else list.delete(id)\n  const result = Array.from(list)\n  uncontrolledExpanded.value = result\n  expanded.value = result\n}\n\nfunction select(item: TreeItem) {\n  if (item.disabled) return\n  uncontrolledValue.value = item.id\n  value.value = item.id\n  emit(\"select\", item.id, item)\n}\n\nfunction focus(id: string | undefined | null) {\n  if (!id) return\n  focusedId.value = id\n  refs.get(id)?.focus()\n}\n\nfunction onKeydown(event: KeyboardEvent, entry: VisibleItem) {\n  const list = visible.value\n  const index = list.findIndex((candidate) => candidate.item.id === entry.item.id)\n  const { item } = entry\n  const hasChildren = Boolean(item.children?.length)\n  const isOpen = open.value.has(item.id)\n  const rtl = getComputedStyle(event.currentTarget as Element).direction === \"rtl\"\n  const forward = rtl ? \"ArrowLeft\" : \"ArrowRight\"\n  const back = rtl ? \"ArrowRight\" : \"ArrowLeft\"\n\n  switch (event.key) {\n    case \"ArrowDown\":\n      focus(list[index + 1]?.item.id)\n      break\n    case \"ArrowUp\":\n      focus(list[index - 1]?.item.id)\n      break\n    case \"Home\":\n      focus(list[0]?.item.id)\n      break\n    case \"End\":\n      focus(list[list.length - 1]?.item.id)\n      break\n    case forward:\n      if (hasChildren && !isOpen) setOpen(item.id, true)\n      else if (hasChildren) focus(list[index + 1]?.item.id)\n      break\n    case back:\n      if (hasChildren && isOpen) setOpen(item.id, false)\n      else focus(entry.parentId)\n      break\n    case \"Enter\":\n    case \" \":\n      select(item)\n      if (hasChildren && event.key === \"Enter\") setOpen(item.id, !isOpen)\n      break\n    default: {\n      if (event.key.length !== 1 || event.metaKey || event.ctrlKey) return\n      const char = event.key.toLowerCase()\n      const ordered = [...list.slice(index + 1), ...list.slice(0, index + 1)]\n      const match = ordered.find((candidate) =>\n        (candidate.item.textValue ?? candidate.item.label).toLowerCase().startsWith(char),\n      )\n      focus(match?.item.id)\n      break\n    }\n  }\n  event.preventDefault()\n  event.stopPropagation()\n}\n\nprovide(TreeViewContextKey, {\n  visible,\n  open,\n  selected,\n  tabStop,\n  register(id, node) {\n    if (node) refs.set(id, node)\n    else refs.delete(id)\n  },\n  setFocused(id) {\n    focusedId.value = id\n  },\n  onKeydown,\n  onRowClick(item) {\n    focus(item.id)\n    select(item)\n    if (item.children?.length) setOpen(item.id, !open.value.has(item.id))\n  },\n})\n</script>\n\n<template>\n  <ul role=\"tree\" data-slot=\"tree-view\" :class=\"cn('m-0 flex list-none flex-col p-0', props.class)\">\n    <TreeViewNode v-for=\"item in items\" :key=\"item.id\" :item=\"item\" :level=\"1\" />\n  </ul>\n</template>\n"
    },
    {
      "name": "tree-view/TreeViewNode.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed, inject } from \"vue\"\nimport { ChevronRight } from \"@lucide/vue\"\n\nimport { cn } from \"@/lib/utils\"\nimport { TreeViewContextKey, type TreeItem } from \"./context\"\n\ndefineOptions({ name: \"TreeViewNode\" })\n\nconst props = defineProps<{ item: TreeItem; level: number }>()\n\nconst tree = inject(TreeViewContextKey)!\n\nconst entry = computed(() => tree.visible.value.find((candidate) => candidate.item.id === props.item.id))\nconst hasChildren = computed(() => Boolean(props.item.children?.length))\nconst isOpen = computed(() => tree.open.value.has(props.item.id))\nconst isSelected = computed(() => tree.selected.value === props.item.id)\n\nconst rowClass = cn(\n  \"flex h-7 cursor-pointer items-center gap-1.5 rounded-xl pe-2 text-xs select-none hover:bg-muted\",\n  \"data-selected:bg-muted data-selected:font-medium\",\n  \"data-disabled:pointer-events-none data-disabled:opacity-50\",\n  \"[&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-3.5\",\n)\nconst itemClass =\n  \"outline-none [&:focus-visible>[data-slot=tree-view-row]]:ring-3 [&:focus-visible>[data-slot=tree-view-row]]:ring-ring/30\"\n</script>\n\n<template>\n  <li\n    v-if=\"entry\"\n    :ref=\"(node) => tree.register(item.id, node as HTMLLIElement | null)\"\n    role=\"treeitem\"\n    :aria-level=\"level\"\n    :aria-posinset=\"entry.posinset\"\n    :aria-setsize=\"entry.setsize\"\n    :aria-expanded=\"hasChildren ? isOpen : undefined\"\n    :aria-selected=\"isSelected\"\n    :aria-disabled=\"item.disabled || undefined\"\n    :tabindex=\"item.id === tree.tabStop.value ? 0 : -1\"\n    data-slot=\"tree-view-item\"\n    :class=\"itemClass\"\n    @keydown=\"tree.onKeydown($event, entry)\"\n    @focus=\"tree.setFocused(item.id)\"\n  >\n    <div\n      data-slot=\"tree-view-row\"\n      :data-selected=\"isSelected ? '' : undefined\"\n      :data-disabled=\"item.disabled ? '' : undefined\"\n      :style=\"{ paddingInlineStart: `calc(${level - 1} * 1rem + 0.5rem)` }\"\n      :class=\"rowClass\"\n      @click=\"tree.onRowClick(item)\"\n    >\n      <ChevronRight\n        aria-hidden=\"true\"\n        :class=\"\n          cn(\n            'text-muted-foreground transition-transform duration-150 rtl:rotate-180',\n            isOpen && 'rotate-90 rtl:rotate-90',\n            !hasChildren && 'invisible',\n          )\n        \"\n      />\n      <span v-if=\"item.icon\" aria-hidden=\"true\" class=\"flex text-muted-foreground\">\n        <component :is=\"item.icon\" />\n      </span>\n      <span class=\"min-w-0 truncate\">{{ item.label }}</span>\n    </div>\n    <ul v-if=\"hasChildren && isOpen\" role=\"group\" class=\"m-0 list-none p-0\">\n      <TreeViewNode v-for=\"child in item.children\" :key=\"child.id\" :item=\"child\" :level=\"level + 1\" />\n    </ul>\n  </li>\n</template>\n"
    },
    {
      "name": "tree-view/context.ts",
      "content": "import type { Component, ComputedRef, InjectionKey } from \"vue\"\n\nexport type TreeItem = {\n  id: string\n  label: string\n  /** Plain text for typeahead when the rendered label differs from `label`. */\n  textValue?: string\n  /** A component, e.g. an icon from @lucide/vue. */\n  icon?: Component\n  disabled?: boolean\n  children?: TreeItem[]\n}\n\nexport type VisibleItem = {\n  item: TreeItem\n  level: number\n  parentId: string | null\n  posinset: number\n  setsize: number\n}\n\nexport function flatten(\n  items: TreeItem[],\n  expanded: Set<string>,\n  level = 1,\n  parentId: string | null = null,\n  out: VisibleItem[] = [],\n) {\n  items.forEach((item, index) => {\n    out.push({ item, level, parentId, posinset: index + 1, setsize: items.length })\n    if (item.children?.length && expanded.has(item.id)) {\n      flatten(item.children, expanded, level + 1, item.id, out)\n    }\n  })\n  return out\n}\n\nexport type TreeViewContext = {\n  visible: ComputedRef<VisibleItem[]>\n  open: ComputedRef<Set<string>>\n  selected: ComputedRef<string | null>\n  tabStop: ComputedRef<string | undefined>\n  register: (id: string, node: HTMLLIElement | null) => void\n  setFocused: (id: string) => void\n  onKeydown: (event: KeyboardEvent, entry: VisibleItem) => void\n  onRowClick: (item: TreeItem) => void\n}\n\nexport const TreeViewContextKey: InjectionKey<TreeViewContext> = Symbol(\"TreeView\")\n"
    },
    {
      "name": "tree-view/index.ts",
      "content": "export { default as TreeView } from \"./TreeView.vue\"\nexport type { TreeItem } from \"./context\"\n"
    }
  ]
}
