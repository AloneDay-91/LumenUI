{
  "name": "marquee",
  "title": "Marquee",
  "type": "registry:ui",
  "internal": false,
  "dependencies": [
    "@lucide/vue"
  ],
  "registryDependencies": [
    "utils"
  ],
  "files": [
    {
      "name": "marquee/Marquee.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed, ref, useAttrs, type HTMLAttributes } from \"vue\"\nimport { Pause, Play } from \"@lucide/vue\"\n\nimport { cn } from \"@/lib/utils\"\n\nimport \"./marquee.css\"\n\n/**\n * Children scroll on a loop. Pauses on hover, stops under reduced motion,\n * fades at the edges. The second copy is hidden from assistive tech, and a\n * pause button keeps it compliant with WCAG 2.2.2 when it runs past 5 seconds.\n */\nconst props = withDefaults(\n  defineProps<{\n    orientation?: \"horizontal\" | \"vertical\"\n    /** Seconds for one full loop. */\n    duration?: number\n    gap?: string\n    reverse?: boolean\n    pauseOnHover?: boolean\n    /** Masks the start and end edges. */\n    fade?: boolean\n    /** A small pause / play button in the corner. */\n    showControl?: boolean\n    labels?: { pause?: string; play?: string }\n    class?: HTMLAttributes[\"class\"]\n  }>(),\n  {\n    orientation: \"horizontal\",\n    duration: 30,\n    gap: \"2rem\",\n    reverse: false,\n    pauseOnHover: true,\n    fade: true,\n    showControl: true,\n    labels: () => ({}),\n  }\n)\n\nconst attrs = useAttrs()\nconst paused = ref(false)\nconst vertical = computed(() => props.orientation === \"vertical\")\n// A name only counts on an element with a role.\nconst role = computed(() => (attrs[\"aria-label\"] || attrs[\"aria-labelledby\"] ? \"group\" : undefined))\n\nconst controlClass =\n  \"absolute end-1 bottom-1 flex size-6 items-center justify-center rounded-full bg-background/80 text-muted-foreground opacity-0 ring-1 ring-foreground/10 backdrop-blur-sm transition-opacity outline-none group-hover/marquee:opacity-100 hover:text-foreground focus-visible:opacity-100 focus-visible:ring-3 focus-visible:ring-ring/30 motion-reduce:hidden\"\n</script>\n\n<template>\n  <div\n    data-slot=\"marquee\"\n    :role=\"role\"\n    :data-orientation=\"orientation\"\n    :data-reverse=\"reverse ? '' : undefined\"\n    :data-pause-on-hover=\"pauseOnHover ? '' : undefined\"\n    :data-paused=\"paused ? '' : undefined\"\n    :class=\"\n      cn(\n        'group/marquee relative flex overflow-hidden',\n        vertical ? 'flex-col' : 'flex-row',\n        fade &&\n          (vertical\n            ? 'mask-[linear-gradient(to_bottom,transparent,black_12%,black_88%,transparent)]'\n            : 'mask-[linear-gradient(to_right,transparent,black_12%,black_88%,transparent)]'),\n        props.class,\n      )\n    \"\n    :style=\"{ gap, '--marquee-gap': gap, '--marquee-duration': `${duration}s` }\"\n  >\n    <div\n      v-for=\"hidden in [false, true]\"\n      :key=\"String(hidden)\"\n      data-slot=\"marquee-track\"\n      :aria-hidden=\"hidden || undefined\"\n      :inert=\"hidden || undefined\"\n      :class=\"cn('flex shrink-0 items-center', vertical ? 'flex-col' : 'flex-row')\"\n      :style=\"{ gap }\"\n    >\n      <slot />\n    </div>\n    <button\n      v-if=\"showControl\"\n      type=\"button\"\n      :aria-label=\"paused ? (labels.play ?? 'Play') : (labels.pause ?? 'Pause')\"\n      :class=\"controlClass\"\n      @click=\"paused = !paused\"\n    >\n      <Play v-if=\"paused\" class=\"size-3\" />\n      <Pause v-else class=\"size-3\" />\n    </button>\n  </div>\n</template>\n"
    },
    {
      "name": "marquee/index.ts",
      "content": "export { default as Marquee } from \"./Marquee.vue\"\n"
    },
    {
      "name": "marquee/marquee.css",
      "content": "/* Endless scroll for Marquee. Two copies of the track move by one copy's\n   width, so the loop has no seam. Imported by Marquee.vue. */\n@keyframes lumen-marquee-x {\n  to {\n    transform: translateX(calc(-100% - var(--marquee-gap)));\n  }\n}\n\n@keyframes lumen-marquee-y {\n  to {\n    transform: translateY(calc(-100% - var(--marquee-gap)));\n  }\n}\n\n[data-slot=\"marquee-track\"] {\n  animation: lumen-marquee-x var(--marquee-duration) linear infinite;\n}\n\n[data-slot=\"marquee\"][data-orientation=\"vertical\"] [data-slot=\"marquee-track\"] {\n  animation-name: lumen-marquee-y;\n}\n\n[data-slot=\"marquee\"][data-reverse] [data-slot=\"marquee-track\"] {\n  animation-direction: reverse;\n}\n\n[data-slot=\"marquee\"][data-pause-on-hover]:hover [data-slot=\"marquee-track\"],\n[data-slot=\"marquee\"][data-paused] [data-slot=\"marquee-track\"] {\n  animation-play-state: paused;\n}\n\n/* Right-to-left pages scroll the other way. */\n[dir=\"rtl\"] [data-slot=\"marquee\"]:not([data-orientation=\"vertical\"]) [data-slot=\"marquee-track\"] {\n  animation-direction: reverse;\n}\n\n@media (prefers-reduced-motion: reduce) {\n  [data-slot=\"marquee-track\"] {\n    animation: none;\n  }\n}\n"
    }
  ]
}
