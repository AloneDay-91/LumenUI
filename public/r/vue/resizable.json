{
  "name": "resizable",
  "title": "Resizable",
  "type": "registry:ui",
  "internal": false,
  "dependencies": [
    "@lucide/vue"
  ],
  "registryDependencies": [
    "utils"
  ],
  "files": [
    {
      "name": "resizable/ResizableHandle.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed, inject, onMounted, ref, watch, type HTMLAttributes } from \"vue\"\nimport { GripVertical } from \"@lucide/vue\"\n\nimport { cn } from \"@/lib/utils\"\nimport { ResizableContextKey } from \"./context\"\n\nconst props = withDefaults(\n  defineProps<{\n    withHandle?: boolean\n    ariaLabel?: string\n    class?: HTMLAttributes[\"class\"]\n  }>(),\n  { withHandle: false, ariaLabel: \"Resize panels\" },\n)\n\nconst context = inject(ResizableContextKey)\nif (!context) throw new Error(\"Resizable parts must sit inside ResizablePanelGroup.\")\nconst { direction, sizes, configs, resize, groupRef } = context\n\nconst handleRef = ref<HTMLDivElement | null>(null)\nconst pair = ref<[string, string] | null>(null)\nconst dragging = ref(false)\n\nfunction neighbour(handle: HTMLElement, side: \"previous\" | \"next\") {\n  let node = side === \"previous\" ? handle.previousElementSibling : handle.nextElementSibling\n  while (node && !(node as HTMLElement).dataset.panelId) {\n    node = side === \"previous\" ? node.previousElementSibling : node.nextElementSibling\n  }\n  return (node as HTMLElement | null)?.dataset.panelId\n}\n\nfunction findPair() {\n  if (!handleRef.value) return\n  const before = neighbour(handleRef.value, \"previous\")\n  const after = neighbour(handleRef.value, \"next\")\n  pair.value = before && after ? [before, after] : null\n}\nonMounted(findPair)\nwatch(sizes, findPair, { flush: \"post\" })\n\nconst horizontal = computed(() => direction.value === \"horizontal\")\nconst value = computed(() => (pair.value ? sizes.value[pair.value[0]] : undefined))\nconst config = computed(() => {\n  // Re-read when sizes change, since configs is a plain Map.\n  void sizes.value\n  return pair.value ? configs.get(pair.value[0]) : undefined\n})\n\nfunction onPointerDown(event: PointerEvent) {\n  const current = pair.value\n  if (!current || !groupRef.value) return\n  event.preventDefault()\n  const rect = groupRef.value.getBoundingClientRect()\n  const isHorizontal = horizontal.value\n  const length = isHorizontal ? rect.width : rect.height\n  const rtl = isHorizontal && getComputedStyle(groupRef.value).direction === \"rtl\"\n  let last = isHorizontal ? event.clientX : event.clientY\n  ;(event.currentTarget as HTMLElement).setPointerCapture(event.pointerId)\n  dragging.value = true\n\n  const move = (moveEvent: PointerEvent) => {\n    const position = isHorizontal ? moveEvent.clientX : moveEvent.clientY\n    const delta = ((position - last) / length) * 100 * (rtl ? -1 : 1)\n    last = position\n    resize(current[0], current[1], delta)\n  }\n  const up = () => {\n    dragging.value = false\n    window.removeEventListener(\"pointermove\", move)\n    window.removeEventListener(\"pointerup\", up)\n  }\n  window.addEventListener(\"pointermove\", move)\n  window.addEventListener(\"pointerup\", up)\n}\n\nfunction onKeyDown(event: KeyboardEvent) {\n  const current = pair.value\n  if (!current) return\n  const step = event.shiftKey ? 10 : 2\n  const rtl = horizontal.value && getComputedStyle(event.currentTarget as HTMLElement).direction === \"rtl\"\n  const grow = horizontal.value ? (rtl ? \"ArrowLeft\" : \"ArrowRight\") : \"ArrowDown\"\n  const shrink = horizontal.value ? (rtl ? \"ArrowRight\" : \"ArrowLeft\") : \"ArrowUp\"\n  if (event.key === grow) resize(current[0], current[1], step)\n  else if (event.key === shrink) resize(current[0], current[1], -step)\n  else if (event.key === \"Home\") resize(current[0], current[1], -100)\n  else if (event.key === \"End\") resize(current[0], current[1], 100)\n  else return\n  event.preventDefault()\n}\n\nconst afterClass = \"after:absolute after:content-[''] focus-visible:bg-ring data-dragging:bg-ring\"\n</script>\n\n<template>\n  <div\n    ref=\"handleRef\"\n    role=\"separator\"\n    tabindex=\"0\"\n    :aria-label=\"ariaLabel\"\n    :aria-orientation=\"horizontal ? 'vertical' : 'horizontal'\"\n    :aria-controls=\"pair?.[0]\"\n    :aria-valuenow=\"value === undefined ? undefined : Math.round(value)\"\n    :aria-valuemin=\"config?.minSize\"\n    :aria-valuemax=\"config?.maxSize\"\n    data-slot=\"resizable-handle\"\n    :data-dragging=\"dragging ? '' : undefined\"\n    :class=\"\n      cn(\n        'relative flex shrink-0 touch-none items-center justify-center bg-border outline-none select-none',\n        afterClass,\n        horizontal\n          ? 'w-px cursor-col-resize after:inset-y-0 after:-inset-x-1.5'\n          : 'h-px cursor-row-resize after:inset-x-0 after:-inset-y-1.5',\n        props.class,\n      )\n    \"\n    @pointerdown=\"onPointerDown\"\n    @keydown=\"onKeyDown\"\n  >\n    <span\n      v-if=\"withHandle\"\n      aria-hidden=\"true\"\n      :class=\"\n        cn(\n          'z-10 flex items-center justify-center rounded-full border border-border bg-background text-muted-foreground',\n          horizontal ? 'h-6 w-3.5' : 'h-3.5 w-6 [&_svg]:rotate-90',\n        )\n      \"\n    >\n      <GripVertical class=\"size-2.5\" />\n    </span>\n  </div>\n</template>\n"
    },
    {
      "name": "resizable/ResizablePanel.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed, inject, onBeforeUnmount, useId, watch, type HTMLAttributes } from \"vue\"\n\nimport { cn } from \"@/lib/utils\"\nimport { ResizableContextKey } from \"./context\"\n\nconst props = withDefaults(\n  defineProps<{\n    id?: string\n    /** Initial size, in percent of the group. */\n    defaultSize?: number\n    minSize?: number\n    maxSize?: number\n    class?: HTMLAttributes[\"class\"]\n  }>(),\n  { minSize: 10, maxSize: 100 },\n)\n\nconst context = inject(ResizableContextKey)\nif (!context) throw new Error(\"Resizable parts must sit inside ResizablePanelGroup.\")\n\nconst generated = useId()\nconst id = computed(() => props.id ?? generated)\n\nwatch(\n  () => [id.value, props.defaultSize, props.minSize, props.maxSize] as const,\n  ([nextId, defaultSize, minSize, maxSize], previous) => {\n    if (previous && previous[0] !== nextId) context.unregister(previous[0])\n    context.register(nextId, defaultSize, { minSize, maxSize })\n  },\n  { immediate: true },\n)\nonBeforeUnmount(() => context.unregister(id.value))\n\nconst flex = computed(() => {\n  const size = context.sizes.value[id.value]\n  return size === undefined ? \"1 1 0%\" : `${size} 1 0%`\n})\n</script>\n\n<template>\n  <div\n    :id=\"id\"\n    data-slot=\"resizable-panel\"\n    :data-panel-id=\"id\"\n    :style=\"{ flex }\"\n    :class=\"cn('min-h-0 min-w-0 overflow-hidden', props.class)\"\n  >\n    <slot />\n  </div>\n</template>\n"
    },
    {
      "name": "resizable/ResizablePanelGroup.vue",
      "content": "<script setup lang=\"ts\">\nimport { provide, ref, toRef, type HTMLAttributes } from \"vue\"\n\nimport { cn } from \"@/lib/utils\"\nimport { ResizableContextKey, type Direction, type PanelConfig } from \"./context\"\n\nconst props = withDefaults(\n  defineProps<{\n    direction?: Direction\n    class?: HTMLAttributes[\"class\"]\n  }>(),\n  { direction: \"horizontal\" },\n)\n\nconst emit = defineEmits<{\n  /** Each panel's size, in percent, after a resize. */\n  layout: [sizes: Record<string, number>]\n}>()\n\nconst sizes = ref<Record<string, number>>({})\nconst configs = new Map<string, PanelConfig>()\nconst defaults = new Map<string, number | undefined>()\nconst groupRef = ref<HTMLDivElement | null>(null)\n\nfunction register(id: string, defaultSize: number | undefined, config: PanelConfig) {\n  configs.set(id, config)\n  defaults.set(id, defaultSize)\n  // Panels without a default share whatever the others leave.\n  const entries = Array.from(defaults.entries())\n  const fixed = entries.reduce((sum, [, size]) => sum + (size ?? 0), 0)\n  const free = entries.filter(([, size]) => size === undefined).length\n  const share = free > 0 ? Math.max(0, 100 - fixed) / free : 0\n  sizes.value = Object.fromEntries(entries.map(([key, size]) => [key, size ?? share]))\n}\n\nfunction unregister(id: string) {\n  configs.delete(id)\n  defaults.delete(id)\n  const next = { ...sizes.value }\n  delete next[id]\n  sizes.value = next\n}\n\nfunction resize(beforeId: string, afterId: string, delta: number) {\n  const previous = sizes.value\n  const before = previous[beforeId]\n  const after = previous[afterId]\n  if (before === undefined || after === undefined) return\n  const a = configs.get(beforeId) ?? { minSize: 0, maxSize: 100 }\n  const b = configs.get(afterId) ?? { minSize: 0, maxSize: 100 }\n  const total = before + after\n  const low = Math.max(a.minSize, total - b.maxSize)\n  const high = Math.min(a.maxSize, total - b.minSize)\n  const nextBefore = Math.min(high, Math.max(low, before + delta))\n  if (nextBefore === before) return\n  const next = { ...previous, [beforeId]: nextBefore, [afterId]: total - nextBefore }\n  sizes.value = next\n  emit(\"layout\", next)\n}\n\nprovide(ResizableContextKey, {\n  direction: toRef(props, \"direction\"),\n  sizes,\n  configs,\n  register,\n  unregister,\n  resize,\n  groupRef,\n})\n</script>\n\n<template>\n  <div\n    ref=\"groupRef\"\n    data-slot=\"resizable-panel-group\"\n    :data-direction=\"direction\"\n    :class=\"cn('flex size-full overflow-hidden', direction === 'vertical' ? 'flex-col' : 'flex-row', props.class)\"\n  >\n    <slot />\n  </div>\n</template>\n"
    },
    {
      "name": "resizable/context.ts",
      "content": "import type { InjectionKey, Ref } from \"vue\"\n\nexport type Direction = \"horizontal\" | \"vertical\"\n\nexport type PanelConfig = { minSize: number; maxSize: number }\n\nexport type ResizableContextValue = {\n  direction: Ref<Direction>\n  sizes: Ref<Record<string, number>>\n  configs: Map<string, PanelConfig>\n  register: (id: string, defaultSize: number | undefined, config: PanelConfig) => void\n  unregister: (id: string) => void\n  resize: (beforeId: string, afterId: string, delta: number) => void\n  groupRef: Ref<HTMLDivElement | null>\n}\n\nexport const ResizableContextKey: InjectionKey<ResizableContextValue> = Symbol(\"ResizableContext\")\n"
    },
    {
      "name": "resizable/index.ts",
      "content": "export { default as ResizablePanelGroup } from \"./ResizablePanelGroup.vue\"\nexport { default as ResizablePanel } from \"./ResizablePanel.vue\"\nexport { default as ResizableHandle } from \"./ResizableHandle.vue\"\nexport type { Direction } from \"./context\"\n"
    }
  ]
}
