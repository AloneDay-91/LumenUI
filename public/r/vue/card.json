    {
      "name": "card/index.ts",
      "content": "import { cva, type VariantProps } from \"class-variance-authority\"\n\nexport { default as Card } from \"./Card.vue\"\nexport { default as CardHeader } from \"./CardHeader.vue\"\nexport { default as CardTitle } from \"./CardTitle.vue\"\nexport { default as CardDescription } from \"./CardDescription.vue\"\nexport { default as CardContent } from \"./CardContent.vue\"\nexport { default as CardFooter } from \"./CardFooter.vue\"\n\nexport const cardVariants = cva(\n  \"group/card flex flex-col overflow-hidden rounded-[min(var(--radius-4xl),24px)] text-sm\",\n  {\n    variants: {\n      variant: {\n        default: \"border border-border bg-card text-card-foreground\",\n        secondary: \"bg-input/50 text-secondary-foreground dark:bg-input/30\",\n      },\n      size: {\n        default: \"gap-5 py-5\",\n        sm: \"gap-4 py-4\",\n      },\n    },\n    defaultVariants: {\n      variant: \"default\",\n      size: \"default\",\n    },\n  }\n)\n\nexport type CardVariantProps = VariantProps<typeof cardVariants>\n"
