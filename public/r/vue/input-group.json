{
  "name": "input-group",
  "title": "Input Group",
  "type": "registry:ui",
  "internal": false,
  "dependencies": [],
  "registryDependencies": [
    "utils"
  ],
  "files": [
    {
      "name": "input-group/InputGroup.vue",
      "content": "<script setup lang=\"ts\">\nimport type { HTMLAttributes } from \"vue\"\n\nimport { cn } from \"@/lib/utils\"\n\nconst groupClassName = [\n  \"group/input-group relative flex h-8 w-full min-w-0 items-center rounded-2xl border border-border bg-transparent transition-colors\",\n  \"focus-within:border-ring focus-within:ring-3 focus-within:ring-ring/30\",\n  \"has-aria-invalid:border-destructive has-aria-invalid:ring-3 has-aria-invalid:ring-destructive/20\",\n  \"has-disabled:pointer-events-none has-disabled:opacity-50\",\n  \"[&_[data-slot=input]]:h-full [&_[data-slot=input]]:min-w-0 [&_[data-slot=input]]:flex-1\",\n  \"[&_[data-slot=input]]:rounded-none [&_[data-slot=input]]:border-0 [&_[data-slot=input]]:bg-transparent\",\n  \"[&_[data-slot=input]]:shadow-none [&_[data-slot=input]]:focus-visible:border-transparent [&_[data-slot=input]]:focus-visible:ring-0\",\n  // The group owns the fill and the rings. Without the dark, disabled, and invalid\n  // overrides, the Input painted its own layer over the group's and the text area\n  // read as a second colour next to the icon.\n  \"dark:[&_[data-slot=input]]:bg-transparent dark:[&_[data-slot=input]]:disabled:bg-transparent\",\n  \"[&_[data-slot=input]]:aria-invalid:border-transparent [&_[data-slot=input]]:aria-invalid:ring-0\",\n  \"dark:[&_[data-slot=input]]:aria-invalid:border-transparent dark:[&_[data-slot=input]]:aria-invalid:ring-0\",\n]\n\nconst props = defineProps<{ class?: HTMLAttributes[\"class\"] }>()\n</script>\n\n<template>\n  <div data-slot=\"input-group\" role=\"group\" :class=\"cn(groupClassName, props.class)\">\n    <slot />\n  </div>\n</template>\n"
    },
    {
      "name": "input-group/InputGroupAddon.vue",
      "content": "<script setup lang=\"ts\">\nimport type { HTMLAttributes } from \"vue\"\n\nimport { cn } from \"@/lib/utils\"\n\nconst props = withDefaults(defineProps<{ class?: HTMLAttributes[\"class\"]; align?: \"start\" | \"end\" }>(), {\n  align: \"start\",\n})\n</script>\n\n<template>\n  <div\n    data-slot=\"input-group-addon\"\n    :data-align=\"align\"\n    :class=\"\n      cn(\n        'flex h-full shrink-0 items-center gap-1 text-xs text-muted-foreground [&_svg]:size-3.5',\n        align === 'start' ? 'ps-3 pe-1' : 'ps-1 pe-3',\n        props.class,\n      )\n    \"\n  >\n    <slot />\n  </div>\n</template>\n"
    },
    {
      "name": "input-group/InputGroupInput.vue",
      "content": "<script setup lang=\"ts\">\nimport type { HTMLAttributes } from \"vue\"\n\nimport { cn } from \"@/lib/utils\"\n\nconst inputClassName =\n  \"h-full min-w-0 flex-1 bg-transparent px-3 text-xs outline-none placeholder:text-muted-foreground group-has-data-[align=start]/input-group:ps-1 group-has-data-[align=end]/input-group:pe-1\"\n\nconst props = defineProps<{ class?: HTMLAttributes[\"class\"] }>()\nconst model = defineModel<string | number>()\n</script>\n\n<template>\n  <input v-model=\"model\" data-slot=\"input\" :class=\"cn(inputClassName, props.class)\" />\n</template>\n"
    },
    {
      "name": "input-group/InputGroupText.vue",
      "content": "<script setup lang=\"ts\">\nimport type { HTMLAttributes } from \"vue\"\n\nimport { cn } from \"@/lib/utils\"\n\nconst props = defineProps<{ class?: HTMLAttributes[\"class\"] }>()\n</script>\n\n<template>\n  <span data-slot=\"input-group-text\" :class=\"cn('font-mono text-xs text-muted-foreground', props.class)\">\n    <slot />\n  </span>\n</template>\n"
    },
    {
      "name": "input-group/index.ts",
      "content": "export { default as InputGroup } from \"./InputGroup.vue\"\nexport { default as InputGroupAddon } from \"./InputGroupAddon.vue\"\nexport { default as InputGroupInput } from \"./InputGroupInput.vue\"\nexport { default as InputGroupText } from \"./InputGroupText.vue\"\n"
    }
  ]
}
