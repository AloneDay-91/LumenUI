    {
      "name": "sidebar/SidebarProvider.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed, provide, ref, type HTMLAttributes } from \"vue\"\nimport { useEventListener, useMediaQuery } from \"@vueuse/core\"\n\nimport { cn } from \"@/lib/utils\"\nimport {\n  MOBILE_QUERY,\n  SIDEBAR_KEYBOARD_SHORTCUT,\n  SIDEBAR_WIDTH,\n  SIDEBAR_WIDTH_ICON,\n  SidebarContextKey,\n  type SidebarCollapsible,\n  type SidebarSide,\n  type SidebarState,\n} from \"./context\"\n\n/** Holds the open state. `v-model:open` controls it; ⌘B / Ctrl+B toggles it unless `shortcut` is false. */\nconst props = withDefaults(\n  defineProps<{\n    defaultOpen?: boolean\n    open?: boolean\n    shortcut?: boolean\n    class?: HTMLAttributes[\"class\"]\n  }>(),\n  { defaultOpen: true, open: undefined, shortcut: true },\n)\nconst emit = defineEmits<{ \"update:open\": [open: boolean] }>()\n\nconst isMobile = useMediaQuery(MOBILE_QUERY, { ssrWidth: 1024 })\nconst uncontrolledOpen = ref(props.defaultOpen)\nconst openMobile = ref(false)\nconst side = ref<SidebarSide>(\"left\")\nconst peek = ref(false)\nconst collapsible = ref<SidebarCollapsible | null>(\"offcanvas\")\nconst open = computed(() => props.open ?? uncontrolledOpen.value)\n\nfunction setOpen(next: boolean) {\n  peek.value = false\n  emit(\"update:open\", next)\n  if (props.open === undefined) uncontrolledOpen.value = next\n}\n\nfunction toggleSidebar() {\n  if (isMobile.value) {\n    openMobile.value = !openMobile.value\n    return\n  }\n  if (collapsible.value === \"none\" || collapsible.value === null) return\n  setOpen(!open.value)\n}\n\nuseEventListener(\"keydown\", (event: KeyboardEvent) => {\n  if (!props.shortcut) return\n  if (event.key.toLowerCase() === SIDEBAR_KEYBOARD_SHORTCUT && (event.metaKey || event.ctrlKey)) {\n    event.preventDefault()\n    toggleSidebar()\n  }\n})\n\nconst state = computed<SidebarState>(() => (open.value || peek.value ? \"expanded\" : \"collapsed\"))\n\nprovide(SidebarContextKey, {\n  state,\n  open,\n  peek,\n  setPeek: (value) => (peek.value = value),\n  setOpen,\n  openMobile,\n  setOpenMobile: (value) => (openMobile.value = value),\n  isMobile,\n  toggleSidebar,\n  side,\n  setSide: (value) => (side.value = value),\n  collapsible,\n})\n\nconst style = { \"--sidebar-width\": SIDEBAR_WIDTH, \"--sidebar-width-icon\": SIDEBAR_WIDTH_ICON }\n</script>\n\n<template>\n  <div\n    data-slot=\"sidebar-wrapper\"\n    :style=\"style\"\n    :class=\"\n      cn(\n        'flex h-svh w-full overflow-hidden',\n        'has-data-[variant=floating]:bg-muted/40 has-data-[variant=inset]:bg-muted/40',\n        props.class,\n      )\n    \"\n  >\n    <slot />\n  </div>\n</template>\n"
    },
    {
      "name": "sidebar/SidebarRail.vue",
      "content": "<script setup lang=\"ts\">\nimport type { HTMLAttributes } from \"vue\"\n\nimport { cn } from \"@/lib/utils\"\nimport { useSidebar } from \"./context\"\n\nconst props = defineProps<{ class?: HTMLAttributes[\"class\"] }>()\nconst { toggleSidebar } = useSidebar()\n</script>\n\n<template>\n  <button\n    type=\"button\"\n    data-slot=\"sidebar-rail\"\n    aria-label=\"Toggle sidebar\"\n    title=\"Toggle sidebar\"\n    :class=\"\n      cn(\n        'absolute inset-y-0 z-20 hidden w-2 cursor-ew-resize transition-colors after:absolute after:inset-y-3 after:w-px hover:after:bg-foreground/20 md:block',\n        'group-data-[side=left]/sidebar:right-0 group-data-[side=left]/sidebar:after:right-0 group-data-[side=right]/sidebar:left-0 group-data-[side=right]/sidebar:after:left-0',\n        props.class,\n      )\n    \"\n    @click=\"toggleSidebar\"\n  />\n</template>\n"
    },
    {
      "name": "sidebar/SidebarTrigger.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed, type HTMLAttributes } from \"vue\"\nimport { PanelLeft, PanelRight } from \"@lucide/vue\"\n\nimport { Button, type ButtonVariantProps } from \"@/components/ui/button\"\nimport { useSidebar } from \"./context\"\n\n/** A ghost icon Button that toggles the sidebar. The default slot replaces the panel icon. */\nconst props = withDefaults(\n  defineProps<{\n    variant?: ButtonVariantProps[\"variant\"]\n    size?: ButtonVariantProps[\"size\"]\n    class?: HTMLAttributes[\"class\"]\n  }>(),\n  { variant: \"ghost\", size: \"icon\" },\n)\n\nconst { toggleSidebar, side } = useSidebar()\nconst Icon = computed(() => (side.value === \"right\" ? PanelRight : PanelLeft))\n</script>\n\n<template>\n  <Button data-slot=\"sidebar-trigger\" :variant=\"variant\" :size=\"size\" :class=\"props.class\" @click=\"toggleSidebar\">\n    <slot><component :is=\"Icon\" /></slot>\n    <span class=\"sr-only\">Toggle sidebar</span>\n  </Button>\n</template>\n"
    },
    {
      "name": "sidebar/context.ts",
      "content": "import { inject, type ComputedRef, type InjectionKey, type Ref } from \"vue\"\n\nexport const SIDEBAR_WIDTH = \"16rem\"\n// px-2 group + px-3 row puts a 16px icon at 20px: a 3.5rem rail centres it,\n// so icons never move between the open and the collapsed sidebar.\nexport const SIDEBAR_WIDTH_ICON = \"3.5rem\"\nexport const SIDEBAR_KEYBOARD_SHORTCUT = \"b\"\nexport const MOBILE_QUERY = \"(max-width: 767px)\"\n\nexport type SidebarSide = \"left\" | \"right\"\nexport type SidebarVariant = \"sidebar\" | \"floating\" | \"inset\"\nexport type SidebarCollapsible = \"offcanvas\" | \"icon\" | \"none\"\nexport type SidebarState = \"expanded\" | \"collapsed\"\n\nexport type SidebarContextValue = {\n  /** \"expanded\" while open or while an icon sidebar is opened by hover. */\n  state: ComputedRef<SidebarState>\n  open: ComputedRef<boolean>\n  /** An icon sidebar opened over the page by hover, without changing `open`. */\n  peek: Ref<boolean>\n  setPeek: (peek: boolean) => void\n  setOpen: (open: boolean) => void\n  openMobile: Ref<boolean>\n  setOpenMobile: (open: boolean) => void\n  isMobile: Ref<boolean>\n  toggleSidebar: () => void\n  side: Ref<SidebarSide>\n  setSide: (side: SidebarSide) => void\n  collapsible: Ref<SidebarCollapsible | null>\n}\n\nexport const SidebarContextKey: InjectionKey<SidebarContextValue> = Symbol(\"SidebarContext\")\n\n/** The state of the enclosing SidebarProvider. Values are refs. */\nexport function useSidebar() {\n  const context = inject(SidebarContextKey, null)\n  if (!context) {\n    throw new Error(\"useSidebar must be used within SidebarProvider.\")\n  }\n  return context\n}\n\nexport function widthClass(variant: SidebarVariant, collapsible: SidebarCollapsible, open: boolean) {\n  if (open || collapsible === \"none\") {\n    return variant === \"sidebar\" ? \"w-(--sidebar-width)\" : \"w-[calc(var(--sidebar-width)+1rem)]\"\n  }\n\n  switch (collapsible) {\n    case \"offcanvas\":\n      return \"w-0 border-0 p-0\"\n    case \"icon\":\n      return variant === \"sidebar\" ? \"w-(--sidebar-width-icon)\" : \"w-[calc(var(--sidebar-width-icon)+1rem)]\"\n    default: {\n      const exhaustive: never = collapsible\n      return exhaustive\n    }\n  }\n}\n"
    }
  ]
