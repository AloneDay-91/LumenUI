{
  "name": "lumenui-vue",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Vue 3 sources of Lumen UI (Reka UI). The CLI copies these files with --framework vue; the playground renders every component.",
  "scripts": {
    "predev": "node scripts/sync-css.mjs",
    "dev": "vite",
    "prebuild": "node scripts/sync-css.mjs",
    "build": "vue-tsc --noEmit && vite build",
    "pretypecheck": "node scripts/sync-css.mjs",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@lucide/vue": "^1.81.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.1",
    "vue": "^3.5.46"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-vue": "^6.0.11",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "vite": "^8.4.0",
    "vue-tsc": "^3.3.14"
  }
}
